BLOCK RESETPATHS;
BLOCK ASYNCPATHS;

LOCATE COMP "clock" SITE "F1";
IOBUF  PORT "clock" PULLMODE=NONE IO_TYPE=LVCMOS33;
FREQUENCY PORT "clock" 50 MHZ;

LOCATE COMP "n_reset" SITE "G1";
IOBUF  PORT "n_reset" PULLMODE=UP IO_TYPE=LVCMOS33;

